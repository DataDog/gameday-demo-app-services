{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "datadog-static-analyzer",
          "semanticVersion": "0.7.4",
          "rules": [
            {
              "id": "secrets/aws-access-key",
              "name": "AWS Access Key Scanner",
              "shortDescription": {
                "text": "AWS Access Key Scanner"
              },
              "fullDescription": {
                "text": "Matches a sequence of characters representing a hardcoded AWS access key in source code."
              },
              "properties": {
                "tags": [
                  "DATADOG_RULE_TYPE:SECRET",
                  "DATADOG_SDS_ID:f1e79821-aws0-key0-0001-000000000001"
                ]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "secrets/aws-access-key",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "AWS Access Key Scanner"
          },
          "fixes": [],
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "aws_config.py"
                },
                "region": {
                  "startLine": 3,
                  "endLine": 3,
                  "startColumn": 1,
                  "endColumn": 44
                }
              }
            }
          ],
          "partialFingerprints": {
            "DATADOG_FINGERPRINT": "e6c5d4f3a7b890123456789abcdef01234567890abcdef01234567890abcdef03"
          },
          "properties": {
            "tags": [
              "DATADOG_CATEGORY:SECURITY",
              "DATADOG_SECRET_VALIDATION_STATUS:NOT_AVAILABLE"
            ]
          }
        }
      ]
    }
  ]
}
