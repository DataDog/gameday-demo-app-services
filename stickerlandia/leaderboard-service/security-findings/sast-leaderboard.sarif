{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "datadog-static-analyzer",
          "semanticVersion": "0.6.9",
          "rules": [
            {
              "id": "python-flask/sql-injection",
              "shortDescription": {
                "text": "SQL Injection via string interpolation in Flask endpoint"
              },
              "properties": {
                "tags": [
                  "DATADOG_CATEGORY:SECURITY",
                  "CWE:89"
                ]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "python-flask/sql-injection",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "User input directly interpolated into SQL UPDATE query via f-string without parameterization. An attacker can manipulate the user_id or sticker_count fields to execute arbitrary SQL commands."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app.py"
                },
                "region": {
                  "startLine": 83,
                  "endLine": 83,
                  "startColumn": 13,
                  "endColumn": 105
                }
              }
            }
          ],
          "partialFingerprints": {
            "DATADOG_FINGERPRINT": "c4a3b2d1e5f6789012345678abcdef0123456789abcdef0123456789abcdef01"
          },
          "properties": {
            "tags": [
              "DATADOG_CATEGORY:SECURITY",
              "CWE:89"
            ]
          }
        },
        {
          "ruleId": "python-flask/sql-injection",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "User input directly interpolated into SQL SELECT query via f-string without parameterization. The name parameter from the query string is embedded directly into the LIKE clause, allowing SQL injection."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app.py"
                },
                "region": {
                  "startLine": 103,
                  "endLine": 103,
                  "startColumn": 13,
                  "endColumn": 145
                }
              }
            }
          ],
          "partialFingerprints": {
            "DATADOG_FINGERPRINT": "d5b4c3e2f6a78901234567890abcdef0123456789abcdef0123456789abcdef02"
          },
          "properties": {
            "tags": [
              "DATADOG_CATEGORY:SECURITY",
              "CWE:89"
            ]
          }
        }
      ]
    }
  ]
}
